// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Role enum for user roles
enum Role {
  ADMIN
  SALES
  BUSINESS_DEVELOPMENT_OFFICER
}

// User model for authentication and RBAC
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(BUSINESS_DEVELOPMENT_OFFICER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  leads     Lead[]
  activities Activity[]
}

// Lead model
model Lead {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  company      String?
  source       String     // How the lead was acquired
  status       String     @default("New Lead")
  nextFollowUp DateTime?
  ownerId      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  owner        User       @relation(fields: [ownerId], references: [id])
  activities   Activity[]
  deals        Deal[]
  clients      Client[]
}

// Client model (derived from closed leads)
model Client {
  id              String   @id @default(uuid())
  leadId          String   @unique
  contractValue   Float
  renewalDate     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  lead            Lead     @relation(fields: [leadId], references: [id])
}

// Deal model
model Deal {
  id          String   @id @default(uuid())
  leadId      String
  stage       String   @default("New Lead")
  probability Int      @default(0) // Percentage
  amount      Float
  closeDate   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lead        Lead     @relation(fields: [leadId], references: [id])
  revenue     Revenue[]
}

// Revenue model
model Revenue {
  id        String   @id @default(uuid())
  dealId    String
  amount    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deal      Deal     @relation(fields: [dealId], references: [id])
}

// Activity/Notes model
model Activity {
  id          String   @id @default(uuid())
  leadId      String
  userId      String
  type        String   // Meeting, Call, Note, etc.
  description String
  attachment  String?  // URL to attachment if any
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lead        Lead     @relation(fields: [leadId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

// Report model
model Report {
  id        String   @id @default(uuid())
  type      String   // Weekly, Monthly
  startDate DateTime
  endDate   DateTime
  filePath  String   // Path to PDF file
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
