generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role
  createdAt DateTime @default(now())
  leads     Lead[]   @relation("LeadOwner")
  deals     Deal[]   @relation("DealOwner")
  activities Activity[] @relation("ActivityCreator")
  reports   Report[] @relation("ReportGenerator")
}

enum Role {
  admin
  sales
  bdo
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(new)
  nextFollowUpAt DateTime?
  owner          User       @relation("LeadOwner", fields: [ownerId], references: [id])
  ownerId        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deals          Deal[]
  client         Client?
  activities     Activity[]
}

enum LeadStatus {
  new
  working
  qualified
  won
  lost
}

model Client {
  id           String   @id @default(cuid())
  lead         Lead     @relation(fields: [leadId], references: [id])
  leadId       String   @unique
  accountName  String
  contractValue Float
  renewalDate  DateTime?
  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activities   Activity[]
}

model Deal {
  id          String    @id @default(cuid())
  lead        Lead      @relation(fields: [leadId], references: [id])
  leadId      String
  stage       DealStage @default(prospect)
  amount      Float
  probability Int
  closeDate   DateTime?
  owner       User      @relation("DealOwner", fields: [ownerId], references: [id])
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revenues    Revenue[]
}

enum DealStage {
  prospect
  negotiation
  closed_won
  closed_lost
}

model Revenue {
  id         String   @id @default(cuid())
  deal       Deal     @relation(fields: [dealId], references: [id])
  dealId     String
  amount     Float
  currency   String   @default("USD")
  occurredOn DateTime
  periodMonth Int
  periodYear  Int
  createdAt  DateTime @default(now())
}

model Activity {
  id            String    @id @default(cuid())
  lead          Lead?     @relation(fields: [leadId], references: [id])
  leadId        String?
  client        Client?   @relation(fields: [clientId], references: [id])
  clientId      String?
  type          ActivityType
  content       String
  nextFollowUpAt DateTime?
  mentionedUserIds Json?
  attachments   Json?
  createdBy     User      @relation("ActivityCreator", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime  @default(now())
}

enum ActivityType {
  call
  meeting
  email
  note
}

model Report {
  id            String   @id @default(cuid())
  period        ReportPeriod
  storagePath   String
  generatedAt   DateTime @default(now())
  generatedBy   User     @relation("ReportGenerator", fields: [generatedById], references: [id])
  generatedById String
  sentTo        Json
  metadata      Json?
  checksum      String?
}

enum ReportPeriod {
  week
  month
}

